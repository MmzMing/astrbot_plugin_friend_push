{
  "github_token": {
    "type": "string",
    "description": "GitHub fine-grained PAT，只需目标仓库的 Contents: Read and write 权限",
    "default": ""
  },
  "repo": {
    "type": "string",
    "description": "目标仓库，格式 owner/name",
    "default": "MmzMing/my-blog"
  },
  "branch": {
    "type": "string",
    "description": "提交目标分支",
    "default": "master"
  },
  "config_path": {
    "type": "string",
    "description": "友链配置文件路径",
    "default": "src/config/friendsConfig.ts"
  },
  "image_dir": {
    "type": "string",
    "description": "头像存放目录（仓库内相对路径）",
    "default": "public/assets/images/friends"
  },
  "allowed_qqids": {
    "type": "string",
    "description": "允许使用本命令的 QQ 号，逗号分隔；留空则拒绝所有人",
    "default": ""
  },
  "default_weight": {
    "type": "int",
    "description": "新友链的默认权重",
    "default": 5
  },
  "default_tags": {
    "type": "string",
    "description": "默认标签，逗号分隔",
    "default": "Blog"
  },
  "image_enabled": {
    "type": "bool",
    "description": "是否下载头像并转成 webp 写入 image 字段",
    "default": true
  },
  "image_resize_mode": {
    "type": "string",
    "description": "缩放模式：width / height / longest / none",
    "default": "width"
  },
  "image_target_px": {
    "type": "int",
    "description": "缩放目标像素，服务于上面选定的那条边",
    "default": 900
  },
  "image_upscale": {
    "type": "bool",
    "description": "原图小于目标尺寸时是否放大",
    "default": false
  },
  "image_webp_quality": {
    "type": "int",
    "description": "webp 编码质量 1-100",
    "default": 82
  }
}
